{
  "name": "zeroship",
  "version": "0.0.0",
  "private": true,
  "description": "zeroship monorepo root — pnpm workspace for sdks/, apps/, examples/.",
  "type": "module",
  "main": "sdks/zeroship-stub/index.js",
  "exports": {
    ".": {
      "types": "./sdks/zeroship-stub/index.d.ts",
      "import": "./sdks/zeroship-stub/index.js",
      "default": "./sdks/zeroship-stub/index.js"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --filter './sdks/*' build",
    "test": "pnpm -r --filter './sdks/*' test",
    "check": "pnpm -r --filter './sdks/*' check"
  }
}
