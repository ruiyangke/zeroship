{
  "name": "zeroship",
  "version": "0.0.0",
  "private": true,
  "description": "zeroship monorepo root — pnpm workspace for sdks/, apps/, examples/.",
  "type": "module",
  "main": "sdks/zeroship-stub/index.js",
  "exports": {
    ".": {
      "types": "./sdks/zeroship-stub/index.d.ts",
      "import": "./sdks/zeroship-stub/index.js",
      "default": "./sdks/zeroship-stub/index.js"
    }
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm --filter zeroship-migrate-node build && pnpm --filter @zeroship/migrate build && pnpm --filter zero-migrate-cli build && pnpm --filter @zeroship/db build && pnpm -r --filter './sdks/*' --filter '!@zeroship/db' build",
    "publish:sdks": "deploy/scripts/publish-sdks.sh",
    "test": "pnpm -r --filter './sdks/*' test",
    "check": "pnpm -r --filter './sdks/*' check",
    "gen-types": "node policies/codegen.mjs && pnpm --filter @zeroship/vite-plugin gen-types:all",
    "gen-types:check": "node policies/codegen.mjs --check && pnpm --filter @zeroship/vite-plugin gen-types:all -- --check"
  }
}
