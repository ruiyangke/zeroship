# deploy/ops/Caddyfile - reverse proxy for the zeroship stack.
#
# THE DOMAIN IS NOT BAKED IN. Every site block below is built from
# `{$ZEROSHIP_DOMAIN}`, which Caddy substitutes from the environment at
# config-adapt time. The compose `caddy` service passes it through from the
# same `ZEROSHIP_DOMAIN` the platform services use, so ONE variable moves the
# whole stack to a different domain.
#
#   local dev   unset -> falls back to `zeroship.localhost` (the default in the
#               `{$VAR:default}` form below). Browsers resolve any *.localhost
#               to 127.0.0.1, so no DNS and no hosts-file entry is needed.
#   deployed    set `ZEROSHIP_DOMAIN=<your domain>` in deploy/compose/.env.
#
# Do NOT reintroduce a literal domain here. A hostname in this file is a
# hostname in every deployment that copies it.
#
# EDITING THIS FILE? Run `deploy/ops/caddy-claimed-hosts.sh --write` in the same
# change. Every hostname this file claims - by site block, by `@name host`
# matcher, by `header Host`, or from an `import`ed file - is a name a creator
# app must not be able to register, and crates/control/src/reserved_names.rs
# enforces that from the adapted config that script generates. It is pinned to
# this file's sha256, so an edit without a regenerate fails
# `cargo test -p zeroship-control` rather than silently leaving the reserved
# list describing the edge you replaced.
#
# TLS IS NOT TERMINATED HERE when the stack sits behind a TLS-terminating proxy
# (Cloudflare, an ALB, whatever). That is why every site address carries an
# explicit http:// scheme and `auto_https off` is set: without them Caddy would
# try to provision certificates for names it does not control the DNS-01 path
# for, and ACME HTTP-01 would fight the proxy in front of it.
#
# CONSEQUENCE WORTH KNOWING: because the proxy terminates TLS, the origin sees
# http:// and any code that derives an absolute URL from the request scheme will
# derive http, not https. ZEROSHIP_AUTH_PUBLIC_URL is set explicitly in compose for
# exactly that reason - it is not inferred from the request.
#
# Caddy routes to the MOST SPECIFIC matching site block, so the explicit hosts
# below always win over the wildcard catch-all.
{
	# The origin behind a TLS-terminating proxy. See the header.
	auto_https off
	admin off
}

# auth.<domain> - native auth service owns the OIDC protocol endpoints and
# the login/consent/logout UI.
http://auth.{$ZEROSHIP_DOMAIN:zeroship.localhost} {
	# OAuth2 protocol + discovery/JWKS endpoints.
	handle /oauth2/* {
		reverse_proxy auth:9092
	}
	handle /.well-known/* {
		reverse_proxy auth:9092
	}
	# Everything else (login / consent / logout UI + RP routes).
	handle {
		reverse_proxy auth:9092
	}
}

# control.<domain> - shared creator API edge. The database prefix is reserved
# for Part B, when it routes directly to migrate-server. The catch-all is the
# control plane.
http://control.{$ZEROSHIP_DOMAIN:zeroship.localhost} {
	handle /v1/databases/* {
		reverse_proxy migrate-server:9091
	}
	handle {
		reverse_proxy control:9090
	}
}

# console.<domain> - the creator console.
#
# NOTE, 2026-08-11: this block currently proxies to a console that THIS IMAGE
# DOES NOT SHIP. apps/zeroship-builder was extracted out of the repo by
# 8dbe4a8d4, and control no longer runs with --bootstrap-console, so no `console`
# app is seeded and the gateway will not resolve this host to anything. The
# block is kept so the route is ready when the console is restored from its own
# repo; until then, expect the gateway's not-found body here. See task #318.
http://console.{$ZEROSHIP_DOMAIN:zeroship.localhost} {
	reverse_proxy gateway:8000
}

# api.<domain> - gateway (explicit API host).
http://api.{$ZEROSHIP_DOMAIN:zeroship.localhost} {
	reverse_proxy gateway:8000
}

# Catch-all for hosted creator-app subdomains ({app}.<domain>).
# Least specific - only matches hosts not claimed by a block above.
http://*.{$ZEROSHIP_DOMAIN:zeroship.localhost} {
	reverse_proxy gateway:8000
}
