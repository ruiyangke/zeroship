# Required for Builder's OpenAI integration via LangChain/deepagents.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Sandbox controller (crates/sandbox) endpoint and bearer token.
# Builder's built-in fs/exec tools (write_file, read_file,
# edit_file, ls, execute) talk to the controller's HTTP API at
# `${SANDBOX_URL}/sandboxes/...`.
#
# SANDBOX_URL defaults to http://localhost:9091 (controller's default
# port). Override only if the controller runs on a different host /
# port.
SANDBOX_URL=http://localhost:9091

# SANDBOX_TOKEN must match the controller's SANDBOX_TOKEN. The
# controller refuses to start with a token shorter than 32 bytes.
# Generate one with: head -c 32 /dev/urandom | base64
SANDBOX_TOKEN=

# Scoped registry URL written into generated app workspaces as:
#   @zeroship:registry=<ZEROSHIP_SDK_REGISTRY>
# Docker-backed local sandboxes get host.docker.internal injected by
# the sandbox backend, so this reaches a host or compose Verdaccio on :4873.
ZEROSHIP_SDK_REGISTRY=http://host.docker.internal:4873
