// tests/fixtures/project-config/zeroship.jsonc
//
// The shared fixture for the Rust and TypeScript reader suites. Both parse and
// resolve this file through their production implementation.
//
// It is deliberately awkward. A fixture that only exercises the happy shape
// would pass with two parsers whose options disagree about every interesting
// case, so
// every line below that looks like noise is a case where a naive JSONC reader
// diverges:
//
//   - a `//` inside a string value (every control URL has one)
//   - a `/* */` block comment, including one on the same line as a value
//   - an escaped quote immediately before what looks like a comment opener
//   - a comma inside a string, immediately before a closing brace
//   - a trailing comma in an object and in an array
//   - non-ASCII content in a string
//   - a nested `app` key under `environments`, which the writeback splice must
//     not mistake for the top-level one
//
// EVERY CROSS-TOOL KEY IS EXPLICIT, which is not decoration either: the Rust
// reader has no defaults, so an omitted key would make it error
// while the TypeScript reader produced the schema default. That asymmetry is
// tested directly in each owning reader suite, not by this file.
{
  "$schema": "https://zeroship.ai/schema/project-v1.json",

  "name": "config-fixture",
  "app": "11111111-1111-4111-8111-111111111111",
  /* The control plane. Note the `//` in the value. */
  "control": "https://control.zeroship.ai",
  "runtime_date": "2026-08-14",

  "build": {
    "mode": "full",
    "serverEntry": "src/index.ts", // an inline comment after a value
    "dist": "dist",
    "output": "dist/app.zship",
  },

  "migrations": {
    "dir": "migrations",
    "out": "generated/zeroship",
  },

  "secrets": ["STRIPE_SECRET_KEY", "OPENAI_API_KEY",],

  "environments": {
    "staging": {
      "app": "22222222-2222-4222-8222-222222222222",
      "control": "https://control.staging.zeroship.ai",
      "protected": true,
      "migrations": { "out": "generated/staging" },
      // The pathological string lives HERE rather than in the root block so the
      // root stays legible as an example. `--env=staging` is dumped and
      // compared too, so it is just as load-bearing.
      //
      // It carries, in order: an escaped quote followed by a comment opener
      // that must NOT start a comment; a comma directly before a closing brace
      // that must NOT be treated as trailing; and multi-byte content that must
      // survive parsing and canonical resolution.
      "build": { "serverEntry": "src/a\"/*b*/,}-café-😀.ts" }
    }
  }
}
