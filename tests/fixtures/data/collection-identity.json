{
  "valid": {
    "manual_id": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true
        },
        "slug": {
          "type": "string",
          "unique": true
        }
      }
    },
    "generated_id": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true,
          "assign": {
            "by": "typedId",
            "on": "insert"
          }
        }
      }
    },
    "integer_id": {
      "fields": {
        "id": {
          "type": "integer",
          "required": true,
          "primaryKey": true
        }
      }
    },
    "non_primary_column": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true
        },
        "tenant": {
          "type": "string",
          "required": true,
          "primaryKey": false
        }
      }
    },
    "renamed_primary_key": {
      "fields": {
        "key": {
          "type": "string",
          "required": true,
          "primaryKey": true
        }
      }
    },
    "multiple_primary_keys": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true
        },
        "tenant": {
          "type": "string",
          "required": true,
          "primaryKey": true
        }
      }
    }
  },
  "invalid": {
    "empty_fields": {
      "fields": {},
      "error": "collection requires a declared primary key"
    },
    "null_id": {
      "fields": {
        "id": null
      },
      "error": "collection requires a declared primary key"
    },
    "missing_primary_key": {
      "fields": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "error": "collection requires a declared primary key"
    },
    "false_primary_key": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": false
        }
      },
      "error": "collection requires a declared primary key"
    },
    "string_primary_key": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": "true"
        }
      },
      "error": "collection requires a declared primary key"
    },
    "missing_required": {
      "fields": {
        "id": {
          "type": "string",
          "primaryKey": true
        }
      },
      "error": "primary key columns must be required and non-null"
    },
    "optional_id": {
      "fields": {
        "id": {
          "type": "string",
          "required": false,
          "primaryKey": true
        }
      },
      "error": "primary key columns must be required and non-null"
    },
    "string_required": {
      "fields": {
        "id": {
          "type": "string",
          "required": "true",
          "primaryKey": true
        }
      },
      "error": "primary key columns must be required and non-null"
    },
    "id_assignment_on_write": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true,
          "assign": {
            "by": "actor",
            "on": "write"
          }
        }
      },
      "error": "primary key columns can only be assigned on insertion"
    },
    "id_assignment_on_delete": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true,
          "assign": {
            "by": "actor",
            "on": "delete"
          }
        }
      },
      "error": "primary key columns can only be assigned on insertion"
    },
    "masked_key": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true,
          "mask": {
            "kind": "full"
          }
        }
      },
      "error": "primary key columns cannot be masked or encrypted"
    },
    "encrypted_key": {
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "primaryKey": true,
          "encrypted": true
        }
      },
      "error": "primary key columns cannot be masked or encrypted"
    }
  }
}
