// zeroship.jsonc - this project's tooling configuration. COMMITTED.
//
// It is read by the `zeroship` CLI and by the build. The file itself is NEVER
// read by the runtime or packed. Its runtime_date is copied into the manifest
// as inert metadata.
//
// NO SECRETS. This file is tracked, and a plaintext secret in a tracked file is
// unrecoverable once committed. Declare NAMES under `secrets`; put the values
// in `.env` (local dev, git-ignored) or `zeroship secret set` (deployed).
{
  "$schema": "https://zeroship.ai/schema/project-v1.json",

  "name": "scaffold-app",

  // Where `zeroship deploy` and `zeroship migrate` send things.
  "control": "https://control.zeroship.ai",

  // Stamped with today's UTC date by the scaffolder and carried in the manifest.
  // The runtime does not branch on it yet.
  "runtime_date": "2026-08-14",

  "build": {
    // "full" builds a worker (server code + RPC). "static" is an SSG-only
    // deploy: no worker, just the files in `dist`.
    "mode": "full",
    "dist": "dist",
    "output": "dist/app.zship"
  },

  // Databases by LOCAL LABEL. Every key is written out rather than left to a
  // default: the CLI has NO fallbacks for these, so a silent file errors
  // naming the key instead of letting it and the build disagree about a path.
  "databases": {
    "main": {
      "id": "dbs_03evr3oqx1200yeb1kbds8wyq",
      "migrations": "migrations",
      "out": "generated/zeroship"
    }
  },

  // `app` is ABSENT on purpose: the first `zeroship deploy` creates the app and
  // writes its id under this label.
  "apps": {
    "app": {
      "databases": ["main"],
      "primary": "main"
    }
  },

  // Secret NAMES only. `zeroship deploy` can then tell you which ones the
  // deployed app is still missing.
  "secrets": []
}
