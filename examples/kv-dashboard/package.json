{
  "name": "kv-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke": "cargo test --manifest-path ../../Cargo.toml -p zeroship-cli --test kv_deployment -- --nocapture",
