{
  "name": "kv-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke": "vitest run --mode existing --project dashboard tests/rpc.test.ts",
    "test:acceptance": "vitest run --project dashboard",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --mode existing --project dashboard tests/browser.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "catalog:",
    "@zeroship/kv": "workspace:*",
    "@zeroship/rpc": "workspace:*",
    "@zeroship/server": "workspace:*",
    "@zeroship/vite-plugin": "workspace:*",
    "react": "catalog:react18",
    "react-dom": "catalog:react18"
  },
  "devDependencies": {
    "@zeroship/example-fixtures": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "@zeroship/types": "workspace:*",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.7",
    "zeroship": "workspace:*"
  }
}
