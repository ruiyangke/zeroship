{
  "name": "kv-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke": "vitest run tests/rpc.test.ts",
    "test:acceptance": "pnpm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "cargo test --manifest-path tests/platform/Cargo.toml --test acceptance -- --nocapture",
    "test:browser": "vitest run tests/browser.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "catalog:",
    "@zeroship/kv": "workspace:*",
    "@zeroship/rpc": "workspace:*",
    "@zeroship/server": "workspace:*",
    "@zeroship/vite-plugin": "workspace:*",
    "react": "catalog:react18",
    "react-dom": "catalog:react18"
  },
  "devDependencies": {
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "@zeroship/types": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zeroship": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "^4.1.7",
    "playwright": "1.58.2"
  }
}
