// zeroship.jsonc - tooling configuration for examples/starter. COMMITTED.
//
// Read by the `zeroship` CLI and by the build; never by the runtime, never
// packed into the .zship. No secrets: names only, values in .env or
// `zeroship secret set`.
//
// The local stack `zeroship dev init` plus docker compose bring up. A real
// creator app points at the hosted control plane, which is what the scaffold
// template (packages/create-zeroship-app/template/zeroship.jsonc) ships.
//
// The app entry carries no `app` id: the first `zeroship deploy` auto-creates
// the app and writes its id under this label.

{
  "$schema": "https://zeroship.ai/schema/project-v1.json",

  "name": "starter",
  "control": "http://localhost:9090",
  "runtime_date": "2026-08-14",

  "build": {
    "mode": "full",
    "dist": "dist",
    "output": "dist/app.zship"
  },

  // This app reaches no database, so it declares none and gets no `env.db`.
  "databases": {},

  "apps": {
    "starter": { "databases": [] }
  },

  "secrets": []
}
