{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["@zeroship/types", "@zeroship/db/env"],
    "paths": {
      "zeroship-schema": ["./src/server.ts"]
    }
  },
  "include": ["src/**/*"]
}
