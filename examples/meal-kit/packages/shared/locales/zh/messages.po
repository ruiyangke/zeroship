#. js-lingui-explicit-id
msgid "Lemon & herb chicken"
msgstr "柠檬香草烤鸡"

#. js-lingui-explicit-id
msgid "with golden potatoes & broccolini"
msgstr "搭配金黄土豆与西兰花苗"

#. js-lingui-explicit-id
msgid "A little comfort"
msgstr "暖心家常"

#. js-lingui-explicit-id
msgid "Oven, baking tray, frying pan"
msgstr "烤箱、烤盘、平底锅"

#. js-lingui-explicit-id
msgid "Chicken breast"
msgstr "鸡胸肉"

#. js-lingui-explicit-id
msgid "Baby potatoes"
msgstr "小土豆"

#. js-lingui-explicit-id
msgid "Broccolini"
msgstr "西兰花苗"

#. js-lingui-explicit-id
msgid "Lemon, garlic & herb butter"
msgstr "柠檬、大蒜与香草黄油"

#. js-lingui-explicit-id
msgid "Heat the oven to 200°C. Halve the potatoes and toss with oil, salt and pepper on a baking tray."
msgstr "将烤箱预热至200°C。土豆切半，加入油、盐和胡椒，放入烤盘。"

#. js-lingui-explicit-id
msgid "Roast the potatoes until golden and tender. Season the chicken with the supplied herbs."
msgstr "将土豆烤至金黄软糯。用香草为鸡肉调味。"

#. js-lingui-explicit-id
msgid "Sear the chicken, then finish in the oven until cooked through. Check the thickest part reaches a safe cooking temperature."
msgstr "煎香鸡肉后放入烤箱烤熟。检查最厚处温度，确保熟透。"

#. js-lingui-explicit-id
msgid "Sauté the broccolini. Rest and slice the chicken, then serve with lemon and herb butter."
msgstr "炒熟西兰花苗。鸡肉静置后切片，搭配柠檬和香草黄油。"

#. js-lingui-explicit-id
msgid "Garden pesto rigatoni"
msgstr "罗勒青酱通心粉"

#. js-lingui-explicit-id
msgid "with roasted tomatoes & parmesan"
msgstr "搭配烤番茄与帕尔玛奶酪"

#. js-lingui-explicit-id
msgid "Plant-forward favorite"
msgstr "缤纷素食"

#. js-lingui-explicit-id
msgid "Saucepan, frying pan"
msgstr "煮锅、平底锅"

#. js-lingui-explicit-id
msgid "Rigatoni"
msgstr "通心粉"

#. js-lingui-explicit-id
msgid "Cherry tomatoes"
msgstr "樱桃番茄"

#. js-lingui-explicit-id
msgid "Basil pesto"
msgstr "罗勒青酱"

#. js-lingui-explicit-id
msgid "Parmesan & fresh basil"
msgstr "帕尔玛奶酪与新鲜罗勒"

#. js-lingui-explicit-id
msgid "Bring salted water to a boil and cook the rigatoni until just tender."
msgstr "烧开盐水，将通心粉煮至适口。"

#. js-lingui-explicit-id
msgid "Sauté the cherry tomatoes in a little oil until blistered."
msgstr "少许油煎樱桃番茄至表皮起皱。"

#. js-lingui-explicit-id
msgid "Reserve some pasta water, then drain. Toss pasta with pesto and tomatoes, loosening with cooking water."
msgstr "保留一些煮面水。将面、青酱和番茄拌匀，加入煮面水调整稠度。"

#. js-lingui-explicit-id
msgid "Finish with parmesan and torn basil. Taste and season to your liking."
msgstr "撒上奶酪和罗勒叶，按喜好调味。"

#. js-lingui-explicit-id
msgid "Miso-glazed salmon"
msgstr "味噌照烧三文鱼"

#. js-lingui-explicit-id
msgid "with jasmine rice & crunchy greens"
msgstr "搭配茉莉香米与爽脆蔬菜"

#. js-lingui-explicit-id
msgid "Something special"
msgstr "犒赏自己"

#. js-lingui-explicit-id
msgid "Frying pan, saucepan"
msgstr "平底锅、煮锅"

#. js-lingui-explicit-id
msgid "Salmon fillet"
msgstr "三文鱼排"

#. js-lingui-explicit-id
msgid "Jasmine rice"
msgstr "茉莉香米"

#. js-lingui-explicit-id
msgid "Cucumber & edamame"
msgstr "黄瓜与毛豆"

#. js-lingui-explicit-id
msgid "Miso glaze & sesame"
msgstr "味噌酱与芝麻"

#. js-lingui-explicit-id
msgid "Rinse the rice and cook according to the supplied recipe card."
msgstr "淘洗大米，按照食谱卡煮熟。"

#. js-lingui-explicit-id
msgid "Brush salmon with miso glaze and pan-cook until cooked through."
msgstr "三文鱼刷上味噌酱，煎至熟透。"

#. js-lingui-explicit-id
msgid "Slice cucumber into ribbons. Warm the edamame."
msgstr "将黄瓜切成薄片，煮热毛豆。"

#. js-lingui-explicit-id
msgid "Serve salmon over rice with greens and the remaining sauce. Sprinkle with sesame."
msgstr "将三文鱼放在米饭上，配上蔬菜、酱汁和芝麻。"

#. js-lingui-explicit-id
msgid "Sunshine harvest bowl"
msgstr "阳光烤蔬谷物碗"

#. js-lingui-explicit-id
msgid "with harissa cauliflower & chickpeas"
msgstr "搭配哈里萨花椰菜与鹰嘴豆"

#. js-lingui-explicit-id
msgid "Feel-good food"
msgstr "轻盈好滋味"

#. js-lingui-explicit-id
msgid "Oven, baking tray, bowl"
msgstr "烤箱、烤盘、碗"

#. js-lingui-explicit-id
msgid "Cauliflower"
msgstr "花椰菜"

#. js-lingui-explicit-id
msgid "Chickpeas & couscous"
msgstr "鹰嘴豆与库斯库斯"

#. js-lingui-explicit-id
msgid "Harissa spice blend"
msgstr "哈里萨香料"

#. js-lingui-explicit-id
msgid "Yogurt & herbs"
msgstr "酸奶与香草"

#. js-lingui-explicit-id
msgid "Heat the oven to 200°C. Toss cauliflower and chickpeas with oil and harissa."
msgstr "预热烤箱至200°C。花椰菜和鹰嘴豆拌入油与哈里萨香料。"

#. js-lingui-explicit-id
msgid "Roast until the cauliflower is tender with crisp edges."
msgstr "烤至花椰菜软嫩、边缘焦脆。"

#. js-lingui-explicit-id
msgid "Cover couscous with hot water, let stand, then fluff with a fork."
msgstr "库斯库斯加入热水焖熟，用叉子拨松。"

#. js-lingui-explicit-id
msgid "Build your bowl and finish with yogurt, lemon and herbs."
msgstr "将食材装碗，搭配酸奶、柠檬与香草。"

#. js-lingui-explicit-id
msgid "Creamy woodland orzo"
msgstr "奶油蘑菇米形意面"

#. js-lingui-explicit-id
msgid "with baby spinach & fresh thyme"
msgstr "搭配嫩菠菜与新鲜百里香"

#. js-lingui-explicit-id
msgid "Cozy nights in"
msgstr "家的温暖"

#. js-lingui-explicit-id
msgid "Deep frying pan"
msgstr "深平底锅"

#. js-lingui-explicit-id
msgid "Orzo pasta"
msgstr "米形意面"

#. js-lingui-explicit-id
msgid "Mixed mushrooms"
msgstr "混合蘑菇"

#. js-lingui-explicit-id
msgid "Baby spinach"
msgstr "嫩菠菜"

#. js-lingui-explicit-id
msgid "Parmesan, cream & thyme"
msgstr "奶酪、奶油与百里香"

#. js-lingui-explicit-id
msgid "Slice the mushrooms. Sauté in oil until golden, then add the thyme."
msgstr "蘑菇切片，煎至金黄后加入百里香。"

#. js-lingui-explicit-id
msgid "Stir in the orzo and supplied stock. Simmer, stirring, until tender."
msgstr "加入意面和高汤，小火煮至软熟，期间搅拌。"

#. js-lingui-explicit-id
msgid "Fold in spinach and cream, letting the spinach wilt."
msgstr "加入菠菜和奶油，煮至菠菜变软。"

#. js-lingui-explicit-id
msgid "Finish with parmesan, black pepper and a little fresh thyme."
msgstr "最后撒上奶酪、黑胡椒和百里香。"

#. js-lingui-explicit-id
msgid "Sticky ginger tofu"
msgstr "姜香芝麻豆腐"

#. js-lingui-explicit-id
msgid "with rainbow vegetables & rice"
msgstr "搭配彩虹蔬菜与米饭"

#. js-lingui-explicit-id
msgid "Big flavor, little effort"
msgstr "简单又有滋味"

#. js-lingui-explicit-id
msgid "Firm tofu"
msgstr "老豆腐"

#. js-lingui-explicit-id
msgid "Rice"
msgstr "大米"

#. js-lingui-explicit-id
msgid "Broccoli & carrots"
msgstr "西兰花与胡萝卜"

#. js-lingui-explicit-id
msgid "Ginger sesame sauce"
msgstr "姜香芝麻酱"

#. js-lingui-explicit-id
msgid "Rinse and cook the rice. Pat the tofu dry and cut into cubes."
msgstr "淘米煮饭。豆腐擦干后切块。"

#. js-lingui-explicit-id
msgid "Pan-fry tofu in a little oil until crisp on all sides."
msgstr "用少许油将豆腐煎至各面金黄。"

#. js-lingui-explicit-id
msgid "Add the vegetables and stir-fry until tender. Add the ginger sesame sauce."
msgstr "加入蔬菜炒熟，再加入姜香芝麻酱。"

#. js-lingui-explicit-id
msgid "Toss gently until glossy, then serve over rice."
msgstr "轻轻拌匀至酱汁包裹食材，搭配米饭享用。"

#. js-lingui-explicit-id
msgid "Cooking oil, salt and pepper"
msgstr "食用油、盐和胡椒"

#. js-lingui-explicit-id
msgid "Follow the storage instructions and use-by date on each ingredient label."
msgstr "请按各食材包装上的说明保存，并在标注的食用期限内使用。"

#. js-lingui-explicit-id
msgid "Illustrative values per serving, prepared as directed."
msgstr "每人份参考营养值，按食谱制作计算。"

#. js-lingui-explicit-id
msgid "Choose an available delivery date."
msgstr "请选择可用的配送日期。"

