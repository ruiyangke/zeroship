msgid "This area is available to authorized operators. Sign in with your staff account."
msgstr "此区域仅向授权运营人员开放，请使用员工账户登录。"

msgid "This box"
msgstr "当前选择"

msgid "This box uses your saved meals and address. Check the delivery date and total before confirming."
msgstr "这份食材箱将使用已保存的菜品和地址，请确认配送日期和金额。"

msgid "This box will be canceled and any payment refunded. Your weekly plan will continue."
msgstr "这份食材箱将被取消，已支付的款项将退回。每周配送仍会继续。"

msgid "This delivery date is no longer available. Choose a new date, then review your meals."
msgstr "这个日期已无法配送。请选择新日期，再确认菜品。"

msgid "This meal is unavailable in your delivery area."
msgstr "你所在的配送地区暂不提供这道菜。"

msgid "This removes the saved address. Existing deliveries and your weekly plan keep their current address."
msgstr "此操作仅删除已保存的地址，已有配送和每周配送的地址不会改变。"

msgid "This week's menu"
msgstr "本周菜单"

msgid "Thoughtfully chosen recipes. Fresh ingredients at your door. A little less to do, a little more to enjoy."
msgstr "用心挑选的食谱，新鲜食材送到家。少一些忙碌，多一些餐桌上的美好。"

