msgstr "重新付款前，请先确认最新金额。"

#. js-lingui-explicit-id
msgid "Box canceled and payment refunded"
msgstr "食材箱已取消，款项已退回"

#. js-lingui-explicit-id
msgid "Box canceled"
msgstr "食材箱已取消"

#. js-lingui-explicit-id
msgid "The order changed. Reload and try again."
msgstr "订单已变更，请刷新后重试。"

#. js-lingui-explicit-id
msgid "Resolve the payment before editing this box."
msgstr "请先完成支付，再修改食材箱。"

#. js-lingui-explicit-id
