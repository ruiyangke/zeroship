{
  "name": "db-hitcounter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal migration-first env.db hit counter used by the deployed DB end-to-end test.",
  "scripts": {
    "migrate": "zeroship-dev-migrate",
    "gen-types": "vite build --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@zeroship/db": "workspace:*",
    "@zeroship/server": "workspace:*",
    "@zeroship/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "@zeroship/example-fixtures": "workspace:*",
    "@zeroship/migrate": "workspace:*",
    "@zeroship/types": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "vitest": "^4.1.7"
  }
}
