{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@zeroship/types"],
    "paths": {
      "zeroship-schema": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
