{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["@zeroship/types"],
    "paths": {
      "@/*": ["./src/*"],
      "zeroship-schema": ["./src/server.ts"]
    }
  },
  "include": ["src"]
}
