{
  "name": "auth-uploads-kv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Authenticated file drop: env.auth + env.storage + env.kv + RPC in one app, with per-user object scoping and a KV rate limit.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke": "bash scripts/smoke.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zeroship/auth": "workspace:*",
    "@zeroship/kv": "workspace:*",
    "@zeroship/rpc": "workspace:*",
    "@zeroship/server": "workspace:*",
    "@zeroship/storage": "workspace:*",
    "@zeroship/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "@zeroship/types": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zeroship": "workspace:*"
  }
}
