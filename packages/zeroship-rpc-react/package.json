{
  "name": "@zeroship/rpc-react",
  "version": "0.1.0",
  "private": true,
  "description": "React adapter for @zeroship/rpc-client — TanStack Query hooks on every procedure",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.tsx test/*.test.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@zeroship/rpc-client": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.96.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@zeroship/rpc-client": "file:../zeroship-rpc-client",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
