{
  "name": "@zeroship/payments",
  "version": "0.1.0",
  "description": "Payments SDK for zeroship — Stripe Checkout and webhook helpers",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@zeroship/control": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "^2.1.0"
  }
}
