+/// Result fanned out from one binding-level live-catalog read.
+pub(crate) type IntrospectionFlightResult = Result<Rc<LiveSchema>, DbError>;
+
+/// Result of claiming the per-thread introspection singleflight for a binding.
+pub(crate) enum IntrospectionFlightState {
+    /// This caller owns the read. Its generation prevents stale cancellation
+    /// from removing a newer flight for the same binding.
+    Leader { generation: u64 },
+    /// Another caller owns the read; await its result instead of walking the
+    /// catalog again.
+    Follower {
+        receiver: oneshot::Receiver<IntrospectionFlightResult>,
+    },
+}
+
+struct CachedIntrospectedSchema {
+    schema: Option<serde_json::Value>,
+    weight: usize,
+    last_used: u64,
+}
+
+struct IntrospectionFlight {
+    generation: u64,
+    waiters: Vec<oneshot::Sender<IntrospectionFlightResult>>,
+}
+
+/// All collection-keyed metadata owned by one app on this worker thread.
+#[derive(Default)]
+struct AppMetadata {
+    /// Collections registered for this app on this worker thread.
+    registered_models: HashSet<String>,
+
+    /// Raw schemas declared by successful `registerModel` calls, keyed by
+    /// collection. These drive the SQLite fallback and drift-check sweep.
+    schemas: HashMap<String, serde_json::Value>,
+
+    /// Live-catalog metadata, keyed by deploy token and then collection.
+    /// `schema = None` is a retained negative result, not a cache miss.
+    introspected_schemas: HashMap<String, HashMap<String, CachedIntrospectedSchema>>,
+    introspected_bytes: usize,
+    access_clock: u64,
+
+    /// Binding-level whole-catalog reads currently in progress, keyed by
+    /// deploy token. One read covers every collection for that binding.
+    introspection_flights: HashMap<String, IntrospectionFlight>,
+    next_flight_generation: u64,
+}
+
+impl AppMetadata {
+    fn next_access(&mut self) -> u64 {
+        self.access_clock = self.access_clock.saturating_add(1);
+        self.access_clock
+    }
+
+    fn next_generation(&mut self) -> u64 {
+        self.next_flight_generation = self.next_flight_generation.wrapping_add(1);
+        if self.next_flight_generation == 0 {
+            self.next_flight_generation = 1;
+        }
+        self.next_flight_generation
+    }
+
+    /// Evict this app's least-recently-used entry across every deploy.
+    fn evict_lru(&mut self) -> bool {
+        let Some((deploy_token, collection)) = self
+            .introspected_schemas
+            .iter()
+            .flat_map(|(deploy_token, schemas)| {
+                schemas
+                    .iter()
+                    .map(move |(collection, entry)| (deploy_token, collection, entry.last_used))
+            })
+            .min_by_key(|(_, _, last_used)| *last_used)
+            .map(|(deploy_token, collection, _)| (deploy_token.clone(), collection.clone()))
+        else {
+            return false;
+        };
+
+        let mut deploy_is_empty = false;
+        let removed = self
+            .introspected_schemas
+            .get_mut(&deploy_token)
+            .and_then(|schemas| {
+                let removed = schemas.remove(&collection);
+                deploy_is_empty = schemas.is_empty();
+                removed
+            });
+        if deploy_is_empty {
+            self.introspected_schemas.remove(&deploy_token);
+        }
+        if let Some(entry) = removed {
+            self.introspected_bytes = self.introspected_bytes.saturating_sub(entry.weight);
+            true
+        } else {
+            false
+        }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.registered_models.is_empty()
+            && self.schemas.is_empty()
+            && self.introspected_schemas.is_empty()
+            && self.introspection_flights.is_empty()
+    }
+}
