+/// Resolve one cache miss through an injected whole-catalog reader.
+///
+/// The injected reader is invoked only by the binding-level flight leader. A
+/// whole-catalog read covers every collection, so the flight deliberately keys
+/// on `(app, deploy)` rather than the requested collection. Active followers
+/// receive the same `Rc<LiveSchema>` even when byte admission declines their
+/// requested entry; waking them to recheck only the cache would serialize K
+/// duplicate reads in that case.
+async fn resolve_introspection_miss_with<Read, ReadFuture>(
+    binding: &DbBinding,
+    collection: &str,
+    read: Read,
+) -> Result<Option<Value>, DbError>
+where
+    Read: FnOnce() -> ReadFuture,
+    ReadFuture: Future<Output = Result<LiveSchema, DbError>>,
+{
+    let mut read = Some(read);
+    loop {
+        // A prior leader may have populated this collection before a cancelled
+        // follower won the retry race.
+        if let Some(cached) =
+            crate::context::with_mut(|ctx| ctx.introspected_schema_for(binding, collection))
+        {
+            return Ok(cached);
+        }
+
+        match crate::context::with_mut(|ctx| ctx.begin_introspection(binding)) {
+            IntrospectionFlightState::Leader { generation } => {
+                let guard = IntrospectionLeaderGuard::new(binding, generation);
+                let result = read
+                    .take()
+                    .expect("a caller can lead at most once")()
+                    .await
+                    .map(Rc::new);
+
+                if let Ok(live) = &result {
+                    // Cache every collection this read already covered, not
+                    // only the requested one, under one deploy token. The
+                    // requested entry is admitted first and siblings may spend
+                    // only the remainder of this populate's byte allowance.
+                    crate::context::with_mut(|ctx| {
+                        cache_every_collection_and_request(
+                            ctx,
+                            binding,
+                            live.as_ref(),
+                            collection,
+                        );
+                    });
+                }
+
+                guard.finish(result.clone());
+                return result.map(|live| build_runtime_schema(live.as_ref(), collection));
+            }
+            IntrospectionFlightState::Follower { receiver } => match receiver.await {
+                Ok(result) => {
+                    return result.map(|live| build_runtime_schema(live.as_ref(), collection));
+                }
+                Err(_leader_cancelled) => {
+                    // The leader future was dropped. This follower retains its
+                    // unused reader and loops so one waiter becomes the retry
+                    // leader; no failure or cancelled flight stays cached.
+                }
+            },
+        }
+    }
 }
 
