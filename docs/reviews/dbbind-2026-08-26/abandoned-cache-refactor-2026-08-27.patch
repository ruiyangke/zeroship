+    fn retained_weight(
+        ctx: &mut crate::context::ThreadDbContext,
+        bindings: &[DbBinding],
+        collections: &[String],
+    ) -> (usize, usize) {
+        let mut retained = 0usize;
+        let mut bytes = 0usize;
+        for binding in bindings {
+            for collection in collections {
+                if let Some(schema) = ctx.introspected_schema_for(binding, collection) {
+                    retained += 1;
+                    bytes = bytes.saturating_add(crate::context::introspected_schema_weight(
+                        collection, &schema,
+                    ));
+                }
+            }
+        }
+        (retained, bytes)
