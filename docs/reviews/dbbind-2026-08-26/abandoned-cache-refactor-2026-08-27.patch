 //! observable post-coercion. (PG is the engine's target backend — design §10;
 //! the SQLite dev-tier introspector is a documented follow-up.)
 
+use std::future::Future;
+use std::rc::Rc;
+
 use serde_json::{json, Map, Value};
 
 use crate::binding::DbBinding;
+use crate::context::{IntrospectionFlightResult, IntrospectionFlightState};
 use crate::diff::{ColumnInfo, EncryptionMeta, LiveSchema, MaskMeta, WrappedType};
 use crate::error::DbError;
 
+/// Cancellation-safe ownership of one binding-level catalog read.
+///
+/// Dropping the leader while its read is pending removes only this generation
+/// of the flight. Dropping the senders wakes followers with cancellation; they
+/// loop and one of them claims a fresh flight with its still-unused reader.
+struct IntrospectionLeaderGuard {
+    binding: DbBinding,
+    generation: Option<u64>,
+}
+
+impl IntrospectionLeaderGuard {
+    fn new(binding: &DbBinding, generation: u64) -> Self {
+        Self {
+            binding: binding.clone(),
+            generation: Some(generation),
+        }
+    }
+
+    fn finish(mut self, result: IntrospectionFlightResult) {
+        let generation = self
+            .generation
+            .expect("an introspection leader generation is consumed once");
+        crate::context::with_mut(|ctx| {
+            ctx.finish_introspection(&self.binding, generation, result);
+        });
+        self.generation = None;
+    }
+}
+
+impl Drop for IntrospectionLeaderGuard {
+    fn drop(&mut self) {
+        if let Some(generation) = self.generation.take() {
+            crate::context::with_mut(|ctx| {
+                ctx.cancel_introspection(&self.binding, generation);
+            });
+        }
+    }
+}
