 // compile time and nothing else.
 #![recursion_limit = "256"]
 
+#[cfg(test)]
+#[allow(unsafe_code)]
+mod test_allocator {
+    use std::alloc::{GlobalAlloc, Layout, System};
+    use std::cell::Cell;
+
+    #[derive(Clone, Copy)]
+    struct ThreadStats {
+        tracking: bool,
+        allocated: usize,
+        deallocated: usize,
+    }
+
+    thread_local! {
+        static THREAD_STATS: Cell<ThreadStats> = const {
+            Cell::new(ThreadStats {
+                tracking: false,
+                allocated: 0,
+                deallocated: 0,
+            })
+        };
+    }
+
+    pub(super) struct TrackingAllocator;
+
+    fn record(allocated: usize, deallocated: usize) {
+        let _thread_is_alive = THREAD_STATS.try_with(|stats| {
+            let mut current = stats.get();
+            if current.tracking {
+                current.allocated = current.allocated.saturating_add(allocated);
+                current.deallocated = current.deallocated.saturating_add(deallocated);
+                stats.set(current);
+            }
+        });
+    }
+
+    // SAFETY: every allocation operation is forwarded unchanged to `System`.
+    // The extra work only updates allocation-free thread-local `Cell` state
+    // after a successful allocation or before the matching deallocation.
+    unsafe impl GlobalAlloc for TrackingAllocator {
+        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+            // SAFETY: the caller supplies the `GlobalAlloc` layout contract,
+            // and it is forwarded unchanged to the system allocator.
+            let ptr = unsafe { System.alloc(layout) };
+            if !ptr.is_null() {
+                record(layout.size(), 0);
+            }
+            ptr
+        }
+
+        unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+            // SAFETY: the caller supplies the `GlobalAlloc` layout contract,
+            // and it is forwarded unchanged to the system allocator.
+            let ptr = unsafe { System.alloc_zeroed(layout) };
+            if !ptr.is_null() {
+                record(layout.size(), 0);
+            }
+            ptr
+        }
+
+        unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+            record(0, layout.size());
+            // SAFETY: `ptr` and `layout` are the unchanged pair supplied by the
+            // caller under the `GlobalAlloc::dealloc` contract.
+            unsafe { System.dealloc(ptr, layout) };
+        }
+
+        unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+            // SAFETY: all arguments are forwarded unchanged under the
+            // `GlobalAlloc::realloc` contract.
+            let resized = unsafe { System.realloc(ptr, layout, new_size) };
+            if !resized.is_null() {
+                if new_size >= layout.size() {
+                    record(new_size - layout.size(), 0);
+                } else {
+                    record(0, layout.size() - new_size);
+                }
+            }
+            resized
+        }
+    }
+
+    pub(crate) struct AllocationRegion {
+        active: bool,
+    }
+
+    impl AllocationRegion {
+        pub(crate) fn start() -> Self {
+            THREAD_STATS.with(|stats| {
+                assert!(!stats.get().tracking, "allocation regions must not nest");
+                stats.set(ThreadStats {
+                    tracking: true,
+                    allocated: 0,
+                    deallocated: 0,
+                });
+            });
+            Self { active: true }
+        }
+
+        pub(crate) fn finish(mut self) -> isize {
+            self.active = false;
+            THREAD_STATS.with(|stats| {
+                let current = stats.get();
+                stats.set(ThreadStats {
+                    tracking: false,
+                    allocated: 0,
+                    deallocated: 0,
+                });
+                current.allocated as isize - current.deallocated as isize
+            })
+        }
+    }
+
+    impl Drop for AllocationRegion {
+        fn drop(&mut self) {
+            if self.active {
+                let _thread_is_alive = THREAD_STATS.try_with(|stats| {
+                    let mut current = stats.get();
+                    current.tracking = false;
+                    stats.set(current);
+                });
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+#[global_allocator]
+static TEST_ALLOCATOR: test_allocator::TrackingAllocator = test_allocator::TrackingAllocator;
+
