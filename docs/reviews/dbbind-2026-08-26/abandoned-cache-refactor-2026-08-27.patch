+/// Maximum estimated resident bytes one live-catalog read may add to one app.
+///
+/// The allocator measurement in `crud::introspect_schema` observed a maximum
+/// 17.3x live-to-serialized ratio. Charging at the rounded-up 18x ratio makes a
+/// 40-column schema carrying both encryption and mask facets cost just under
+/// 128 KiB, so 128 KiB is the smallest power-of-two admission budget that
+/// accepts the measured wide fixture.
+pub(crate) const INTROSPECTION_POPULATE_BUDGET_BYTES: usize = 128 * 1024;
+
+/// Maximum estimated resident bytes retained for one app across all deploys.
+///
+/// One current deploy plus the worker default of four deploy-pinned workflow
+/// isolates gives five independently keyed schema generations. Five measured
+/// wide-populate allowances produce a 640 KiB per-app ceiling. This is not
+/// coupled to isolate eviction; the isolate count is only the retention basis.
+pub(crate) const INTROSPECTION_APP_BUDGET_BYTES: usize =
+    5 * INTROSPECTION_POPULATE_BUDGET_BYTES;
+
+const INTROSPECTION_VALUE_HEAP_MULTIPLIER: usize = 18;
+const INTROSPECTION_ENTRY_FIXED_BYTES: usize = 2 * 1024;
+
+/// Conservative resident-byte charge for one introspected cache entry.
+///
+/// The multiplier is the ceiling of the counting-allocator measurement. The
+/// fixed component is the next power of two above the measured 1,875-byte
+/// first negative entry, including its app, deploy, collection, and map
+/// allocations. Charging it on every entry is conservative and prevents
+/// arbitrary absent collection names from bypassing the byte bound.
+pub(crate) fn introspected_schema_weight(
+    collection: &str,
+    schema: &Option<serde_json::Value>,
+) -> usize {
+    struct ByteCounter(usize);
+
+    impl std::io::Write for ByteCounter {
+        fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+            self.0 = self.0.saturating_add(buf.len());
+            Ok(buf.len())
+        }
+
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    let serialized_bytes = schema.as_ref().map_or(0, |value| {
+        let mut counter = ByteCounter(0);
+        serde_json::to_writer(&mut counter, value)
+            .expect("serializing an in-memory serde_json::Value cannot fail");
+        counter.0
+    });
+    let fixed_bytes = INTROSPECTION_ENTRY_FIXED_BYTES.saturating_add(collection.len());
+
+    fixed_bytes.saturating_add(serialized_bytes.saturating_mul(INTROSPECTION_VALUE_HEAP_MULTIPLIER))
+}
