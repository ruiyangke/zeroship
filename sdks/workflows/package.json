{
  "name": "@zeroship/workflows",
  "version": "0.1.0",
  "description": "Durable workflow SDK for zeroship — replayable Workflow classes, steps, sleeps, signals, and child calls",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "import": "./dist/schedule.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint:pkg": "publint && attw --pack .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "catalog:",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
