{
  "name": "@zeroship/auth",
  "version": "0.1.0",
  "description": "Auth SDK for zeroship — platform-managed authentication (server helpers + headless browser client)",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint:pkg": "publint && attw --pack .",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@zeroship/types": "workspace:*",
    "publint": "^0.3.21",
    "react": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zeroship": "workspace:*"
  }
}
