{
  "name": "@zeroship/rpc-react",
  "version": "0.1.0",
  "private": true,
  "description": "React adapter for @zeroship/rpc-client — TanStack Query hooks on every procedure",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.tsx test/*.test.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@zeroship/rpc-client": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "@zeroship/rpc-client": "workspace:*",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "react-test-renderer": "catalog:react18",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
