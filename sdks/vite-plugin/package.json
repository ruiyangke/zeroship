{
  "name": "@zeroship/vite-plugin",
  "version": "0.3.0",
  "description": "Vite plugin for zeroship — full-stack apps with Environment API + ModuleRunner in V8",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node --import tsx scripts/build-bootstrap.ts",
    "build:bootstrap": "node --import tsx scripts/build-bootstrap.ts",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "magic-string": "^0.30.21",
    "unenv": "^1.10.0",
    "ws": "^8.20.0"
  }
}
