{
  "name": "@zeroship/vite-plugin",
  "version": "0.3.0",
  "description": "Vite plugin for zeroship — full-stack apps with Environment API + ModuleRunner in V8",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/client-manifest.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && cp src/client-manifest.d.ts dist/ && node --import tsx scripts/build-bootstrap.ts",
    "build:bootstrap": "node --import tsx scripts/build-bootstrap.ts",
    "dev": "tsc --watch",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "@zeroship/rpc-client": "workspace:*"
  },
  "devDependencies": {
    "@types/mime": "^3.0.4",
    "@types/node": "catalog:",
    "@zeroship/rpc-client": "workspace:*",
    "acorn": "^8.16.0",
    "esbuild": "^0.28.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@zeroship/bootstrap": "workspace:*",
    "magic-string": "^0.30.21",
    "mime": "^3.0.0",
    "tar": "^7.5.13",
    "unenv": "2.0.0-rc.24"
  }
}
