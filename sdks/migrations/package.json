    "prepublishOnly": "npm run build && npm test",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@zeroship/types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zeroship": "workspace:*"
  }
