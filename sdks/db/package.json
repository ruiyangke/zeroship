{
  "name": "@zeroship/db",
  "version": "0.1.0",
  "description": "Mongoose-compatible database SDK for zeroship",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroship-dev/zeroship",
    "directory": "sdks/db"
  },
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@zeroship/types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zeroship": "workspace:*"
  }
}
