{
  "name": "@zeroship/db",
  "version": "0.1.0",
  "description": "Mongoose-compatible database SDK for zeroship",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroship-dev/zeroship.git",
    "directory": "sdks/db"
  },
  "files": [
    "dist",
    "env.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack .",
    "prepublishOnly": "npm run build && npm test",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@zeroship/types": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@zeroship/bootstrap": "workspace:*",
    "fflate": "0.8.2",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zeroship": "workspace:*"
  }
}
