{
  "name": "@zeroship/react",
  "version": "0.1.0",
  "description": "React bindings for @zeroship/db reactive queries — useQuery hook + Suspense variant on top of the broker subscription surface (P8b stage 4).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack .",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.tsx test/*.test.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@zeroship/db": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "@zeroship/db": "workspace:*",
    "publint": "^0.3.21",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "react-test-renderer": "catalog:react18",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
