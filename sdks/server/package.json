{
  "name": "@zeroship/server",
  "version": "0.1.0",
  "description": "Server-side helpers for zeroship apps — defineApp, zod convenience, ambient runtime substrate",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack .",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx"
  },
  "license": "MIT",
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@zeroship/types": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "catalog:",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zeroship": "workspace:*",
    "zod": "catalog:"
  }
}
