{
  "version": 1,
  "resources": {
    "/[...rest]": {
      "auth": "anonymous",
      "publicly_accessible": true
    }
  },
  "assets": {},
  "runtime_assets": {},
  "asset_version": 0,
  "sourcemaps": {},
