{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MigrationIr",
  "description": "The portable migration IR document (`.ir.json`, §2.1).\n\nDeserialized from the JS builder's output. `owner_app` is a HINT — the server\noverrides it at submit time (per-table ownership is server-authoritative) —\nbut the field is carried so the local/dev path and the checksum see it.",
  "type": "object",
  "properties": {
    "ir_version": {
      "description": "IR wire-format version (bump on a breaking shape change).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "name": {
      "description": "Human-readable migration name (no apply effect; mirrors `Migration::name`).",
      "type": "string"
    },
    "owner_app": {
      "description": "The declaring app (a HINT — server overrides at submit). Kept so the\nchecksum and the dev path see an owner.",
      "type": "string",
      "default": ""
    },
    "ops": {
      "description": "The ordered op list — the heart of the migration.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Op"
      }
    },
    "flags": {
      "description": "All-`Option` overrides of the migration flags (Wave C merges them over\nthe derived defaults).",
      "$ref": "#/$defs/IrFlagsOverride",
      "default": {
        "transactional": null,
        "destructive": null,
        "online": null,
        "requires_approval": null,
        "repeatable": null,
        "engine_goodie_ddl": null,
        "timeout_ms": null,
        "phase": null
      }
    },
    "depends_on": {
      "description": "Cross-slice ordering dependencies (migration version strings).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "supersedes": {
      "description": "Versions this migration supersedes (squash).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "preconditions": {
      "description": "Preconditions evaluated before apply (reuses the engine's check type).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PreconditionCheck"
      },
      "default": []
    }
  },
  "required": [
    "ir_version",
    "name",
    "ops"
  ],
  "$defs": {
    "Op": {
      "description": "The CLOSED `op.*` operation enum (§2.3), internally tagged on `\"op\"` and\ncamel-cased (`{\"op\":\"createTable\", …}`). NO `untagged`, NO `flatten` on the\nenum itself — see the module-level note + the ADR.",
      "oneOf": [
        {
          "description": "`CREATE TABLE` with columns + table constraints + indexes.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Table name.",
              "type": "string"
            },
            "columns": {
              "description": "Columns.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/IrColumn"
              }
            },
            "constraints": {
              "description": "Table-level constraints.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/IrConstraint"
              },
              "default": []
            },
            "indexes": {
              "description": "Indexes created with the table.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/IrIndex"
              },
              "default": []
            },
            "op": {
              "type": "string",
              "const": "createTable"
            }
          },
          "required": [
            "op",
            "name",
            "columns"
          ]
        },
        {
          "description": "`DROP TABLE`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Table to drop.",
              "type": "string"
            },
            "if_exists": {
              "description": "`IF EXISTS`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "cascade": {
              "description": "`CASCADE`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "dropTable"
            }
          },
          "required": [
            "op",
            "table"
          ]
        },
        {
          "description": "`ALTER TABLE … ADD COLUMN`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "column": {
              "description": "New column name.",
              "type": "string"
            },
            "type": {
              "description": "New column type.",
              "$ref": "#/$defs/ColType"
            },
            "nullable": {
              "description": "Nullability.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "default": {
              "description": "Default expression.",
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "addColumn"
            }
          },
          "required": [
            "op",
            "table",
            "column",
            "type"
          ]
        },
        {
          "description": "`ALTER TABLE … DROP COLUMN`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "column": {
              "description": "Column to drop.",
              "type": "string"
            },
            "if_exists": {
              "description": "`IF EXISTS`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "dropColumn"
            }
          },
          "required": [
            "op",
            "table",
            "column"
          ]
        },
        {
          "description": "`CREATE [UNIQUE] INDEX [CONCURRENTLY]`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "columns": {
              "description": "Indexed columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "description": "Optional index name.",
              "type": [
                "string",
                "null"
              ]
            },
            "unique": {
              "description": "UNIQUE.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "using": {
              "description": "Index method.",
              "type": [
                "string",
                "null"
              ]
            },
            "where": {
              "description": "Partial-index predicate.",
              "type": [
                "string",
                "null"
              ]
            },
            "concurrently": {
              "description": "`CONCURRENTLY`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "createIndex"
            }
          },
          "required": [
            "op",
            "table",
            "columns"
          ]
        },
        {
          "description": "`DROP INDEX [CONCURRENTLY]`.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Index name.",
              "type": "string"
            },
            "table": {
              "description": "Owning table (dialect hint).",
              "type": [
                "string",
                "null"
              ]
            },
            "if_exists": {
              "description": "`IF EXISTS`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "concurrently": {
              "description": "`CONCURRENTLY`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "dropIndex"
            }
          },
          "required": [
            "op",
            "name"
          ]
        },
        {
          "description": "`ALTER TABLE … ALTER COLUMN … TYPE …`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "column": {
              "description": "Target column.",
              "type": "string"
            },
            "type": {
              "description": "New type.",
              "$ref": "#/$defs/ColType"
            },
            "using": {
              "description": "`USING` cast expression.",
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "alterColumnType"
            }
          },
          "required": [
            "op",
            "table",
            "column",
            "type"
          ]
        },
        {
          "description": "`ALTER TABLE … ALTER COLUMN … SET/DROP NOT NULL`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "column": {
              "description": "Target column.",
              "type": "string"
            },
            "nullable": {
              "description": "The desired nullability.",
              "type": "boolean"
            },
            "op": {
              "type": "string",
              "const": "alterColumnNullability"
            }
          },
          "required": [
            "op",
            "table",
            "column",
            "nullable"
          ]
        },
        {
          "description": "`ALTER TABLE … RENAME COLUMN …` (the new type carried for re-derivation).",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "from": {
              "description": "Old column name.",
              "type": "string"
            },
            "to": {
              "description": "New column name.",
              "type": "string"
            },
            "type": {
              "description": "The column type after rename.",
              "$ref": "#/$defs/ColType"
            },
            "op": {
              "type": "string",
              "const": "renameColumn"
            }
          },
          "required": [
            "op",
            "table",
            "from",
            "to",
            "type"
          ]
        },
        {
          "description": "`ALTER TABLE … ADD CONSTRAINT …`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "constraint": {
              "description": "The constraint to add.",
              "$ref": "#/$defs/IrConstraint"
            },
            "op": {
              "type": "string",
              "const": "addConstraint"
            }
          },
          "required": [
            "op",
            "table",
            "constraint"
          ]
        },
        {
          "description": "`ALTER TABLE … DROP CONSTRAINT …`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "name": {
              "description": "Constraint name.",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "dropConstraint"
            }
          },
          "required": [
            "op",
            "table",
            "name"
          ]
        },
        {
          "description": "`INSERT INTO … VALUES …` with typed scalar rows.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "columns": {
              "description": "Column list.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "description": "Rows, each a positional list of typed scalars.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/IrScalar"
                }
              }
            },
            "op": {
              "type": "string",
              "const": "insert"
            }
          },
          "required": [
            "op",
            "table",
            "columns",
            "rows"
          ]
        },
        {
          "description": "`UPDATE … SET … WHERE …` (optionally batched).",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "set": {
              "description": "Column → fragment assignments (sorted map for canonicality).",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/IrFragment"
              }
            },
            "where": {
              "description": "Optional WHERE fragment.",
              "anyOf": [
                {
                  "$ref": "#/$defs/IrFragment"
                },
                {
                  "type": "null"
                }
              ]
            },
            "batch": {
              "description": "Optional batching knob.",
              "anyOf": [
                {
                  "$ref": "#/$defs/IrBatch"
                },
                {
                  "type": "null"
                }
              ]
            },
            "op": {
              "type": "string",
              "const": "update"
            }
          },
          "required": [
            "op",
            "table",
            "set"
          ]
        },
        {
          "description": "`DELETE FROM … WHERE …`.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "where": {
              "description": "The WHERE fragment (mandatory — no unfiltered delete).",
              "$ref": "#/$defs/IrFragment"
            },
            "limit": {
              "description": "Optional LIMIT.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "delete"
            }
          },
          "required": [
            "op",
            "table",
            "where"
          ]
        },
        {
          "description": "A resumable, cursor-paged backfill.",
          "type": "object",
          "properties": {
            "table": {
              "description": "Target table.",
              "type": "string"
            },
            "cursor_column": {
              "description": "Cursor column to page over.",
              "type": "string"
            },
            "batch_size": {
              "description": "Rows per batch.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "set": {
              "description": "Column → fragment assignments.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/IrFragment"
              }
            },
            "filter": {
              "description": "Optional row filter.",
              "anyOf": [
                {
                  "$ref": "#/$defs/IrFragment"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "description": "Backfill name (journaled progress key).",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "backfill"
            }
          },
          "required": [
            "op",
            "table",
            "cursor_column",
            "batch_size",
            "set",
            "name"
          ]
        },
        {
          "description": "A dialect-split RAW escape hatch — both `pg` and `sqlite` carried so the\nchecksum sees BOTH (a change to either is drift).",
          "type": "object",
          "properties": {
            "pg": {
              "description": "Postgres forward SQL.",
              "type": [
                "string",
                "null"
              ]
            },
            "sqlite": {
              "description": "SQLite forward SQL.",
              "type": [
                "string",
                "null"
              ]
            },
            "down": {
              "description": "Reverse SQL.",
              "anyOf": [
                {
                  "$ref": "#/$defs/RawDown"
                },
                {
                  "type": "null"
                }
              ]
            },
            "op": {
              "type": "string",
              "const": "raw"
            }
          },
          "required": [
            "op"
          ]
        }
      ]
    },
    "IrColumn": {
      "description": "A column definition inside a `createTable` / `addColumn` op.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "type": {
          "description": "Column type.",
          "$ref": "#/$defs/ColType"
        },
        "nullable": {
          "description": "Nullability (default dialect behaviour if absent).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "default": {
          "description": "Default expression (a literal / portable expression string).",
          "type": [
            "string",
            "null"
          ]
        },
        "unique": {
          "description": "Whether the column carries a single-column UNIQUE.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "ColType": {
      "description": "Dialect-NEUTRAL column type lexicon (§3.2). A CLOSED enum so the schema\nenumerates exactly the supported types and the lowering (Wave C) is a total\nmatch. Camel-cased on the wire (`\"int\"`, `\"bigInt\"`, `\"geoPoint\"`, …).",
      "oneOf": [
        {
          "description": "Bounded variable-length string (`VARCHAR`-ish).",
          "type": "string",
          "const": "string"
        },
        {
          "description": "Unbounded text (`TEXT`).",
          "type": "string",
          "const": "text"
        },
        {
          "description": "32-bit signed integer.",
          "type": "string",
          "const": "int"
        },
        {
          "description": "64-bit signed integer.",
          "type": "string",
          "const": "bigInt"
        },
        {
          "description": "Double-precision float.",
          "type": "string",
          "const": "float"
        },
        {
          "description": "Boolean.",
          "type": "string",
          "const": "bool"
        },
        {
          "description": "JSON document (`JSONB` on PG).",
          "type": "string",
          "const": "json"
        },
        {
          "description": "Timestamp (with time zone on PG).",
          "type": "string",
          "const": "timestamp"
        },
        {
          "description": "UUID.",
          "type": "string",
          "const": "uuid"
        },
        {
          "description": "Raw bytes (`BYTEA` on PG, `BLOB` on SQLite).",
          "type": "string",
          "const": "bytea"
        },
        {
          "description": "Foreign-key reference to another table (the referenced table name).",
          "type": "object",
          "properties": {
            "ref": {
              "type": "object",
              "properties": {
                "references": {
                  "description": "The referenced table.",
                  "type": "string"
                }
              },
              "required": [
                "references"
              ]
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "description": "pgvector embedding column of the given dimensionality.",
          "type": "object",
          "properties": {
            "vector": {
              "type": "object",
              "properties": {
                "vector": {
                  "description": "Vector dimensionality.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "vector"
              ]
            }
          },
          "required": [
            "vector"
          ],
          "additionalProperties": false
        },
        {
          "description": "Geographic point (PostGIS `geometry(Point)` / emulated on SQLite).",
          "type": "string",
          "const": "geoPoint"
        },
        {
          "description": "Fixed-precision decimal.",
          "type": "object",
          "properties": {
            "decimal": {
              "type": "object",
              "properties": {
                "precision": {
                  "description": "Total digits.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "scale": {
                  "description": "Digits after the point.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "precision",
                "scale"
              ]
            }
          },
          "required": [
            "decimal"
          ],
          "additionalProperties": false
        },
        {
          "description": "Application-level encrypted column wrapping an inner type.",
          "type": "object",
          "properties": {
            "encrypted": {
              "type": "object",
              "properties": {
                "of": {
                  "description": "The inner (plaintext) type.",
                  "$ref": "#/$defs/ColType"
                }
              },
              "required": [
                "of"
              ]
            }
          },
          "required": [
            "encrypted"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IrConstraint": {
      "description": "A named table constraint.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Optional constraint name (engine-derived if absent).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "description": "PRIMARY KEY over the named columns.",
          "type": "object",
          "properties": {
            "columns": {
              "description": "The key columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "pk"
            }
          },
          "required": [
            "kind",
            "columns"
          ]
        },
        {
          "description": "FOREIGN KEY referencing `(references_table.references_columns)`.",
          "type": "object",
          "properties": {
            "columns": {
              "description": "The referencing columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "references_table": {
              "description": "The referenced table.",
              "type": "string"
            },
            "references_columns": {
              "description": "The referenced columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "fk"
            }
          },
          "required": [
            "kind",
            "columns",
            "references_table",
            "references_columns"
          ]
        },
        {
          "description": "UNIQUE over the named columns.",
          "type": "object",
          "properties": {
            "columns": {
              "description": "The unique columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "unique"
            }
          },
          "required": [
            "kind",
            "columns"
          ]
        },
        {
          "description": "CHECK with a portable boolean expression string.",
          "type": "object",
          "properties": {
            "expr": {
              "description": "The check expression.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "check"
            }
          },
          "required": [
            "kind",
            "expr"
          ]
        }
      ]
    },
    "IrIndex": {
      "description": "An index definition inside a `createTable` op.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Optional index name (engine-derived if absent).",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "Indexed columns.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unique": {
          "description": "Whether the index is UNIQUE.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "using": {
          "description": "Index method (`btree`/`gin`/…); dialect-validated in Wave D.",
          "type": [
            "string",
            "null"
          ]
        },
        "where": {
          "description": "Partial-index predicate (a portable expression string).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "columns"
      ]
    },
    "IrScalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "decimal": {
              "type": "string"
            }
          },
          "required": [
            "decimal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "string"
            }
          },
