                "table"
              ]
            }
          },
          "required": [
            "TableExists"
          ],
          "additionalProperties": false
        },
        {
          "description": "The project schema does NOT contain a table named `table`.",
          "type": "object",
          "properties": {
            "TableNotExists": {
              "type": "object",
              "properties": {
                "table": {
                  "description": "The bare table name (no schema qualifier).",
                  "type": "string"
                }
              },
              "required": [
                "table"
              ]
            }
          },
          "required": [
            "TableNotExists"
          ],
          "additionalProperties": false
        },
        {
          "description": "The project-schema table `table` has a column named `column`.",
          "type": "object",
          "properties": {
            "ColumnExists": {
              "type": "object",
              "properties": {
                "table": {
                  "description": "The bare table name (no schema qualifier).",
                  "type": "string"
                },
                "column": {
                  "description": "The bare column name.",
                  "type": "string"
                }
              },
              "required": [
                "table",
                "column"
              ]
            }
          },
          "required": [
            "ColumnExists"
          ],
          "additionalProperties": false
        },
        {
          "description": "The project-schema table `table` does NOT have a column named `column`.",
          "type": "object",
          "properties": {
            "ColumnNotExists": {
              "type": "object",
              "properties": {
                "table": {
                  "description": "The bare table name (no schema qualifier).",
                  "type": "string"
                },
                "column": {
