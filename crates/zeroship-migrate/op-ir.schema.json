          ],
          "additionalProperties": false
        },
        {
          "description": "`count(*)` of the project-schema table `table` compares to `value` under\n`op` (e.g. `RowCount { table, op: Eq, value: 0 }` = \"the table is empty\").",
          "type": "object",
          "properties": {
            "RowCount": {
