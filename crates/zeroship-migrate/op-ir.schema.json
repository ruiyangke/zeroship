    },
    "Precondition": {
      "description": "A single precondition assertion evaluated against the live DB before a\nmigration's `up` runs.\n\nStructured variants are engine-built parameterized catalog queries\n(injection-safe); [`Precondition::SqlBoolean`] is untrusted SQL run behind\nthe guard + migrator role + single-read-only-SELECT shape gate. See the\nmodule docs.",
      "oneOf": [
        {
          "description": "The project schema contains a table named `table` (a base table or view).",
          "type": "object",
          "properties": {
            "TableExists": {
              "type": "object",
