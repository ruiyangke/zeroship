impl ::zeroship_runtime::macro_runtime::__private::Sealed for Marker {}
#[allow(non_snake_case)]
impl ::zeroship_runtime::macro_runtime::V8ClassInstance for Marker {
    fn is_instance(scope: &mut ::v8::PinScope, value: ::v8::Local<::v8::Value>) -> bool {
        <Self>::is_instance(scope, value)
    }
}
#[allow(non_snake_case, dead_code)]
impl Marker {
    /// Install this class on the given V8 scope, returning the
    /// FunctionTemplate. The runtime calls this from
    /// `setup_globals` and uses the returned template to attach
    /// the class as a global (e.g. `globalThis.Headers`).
    ///
    /// Idempotent per isolate: subsequent calls return the same
    /// FunctionTemplate (looked up via an isolate slot keyed by
    /// the per-class `__InstallSlot_<Class>` marker type emitted
    /// by `#[v8_class]` at module scope). This is what makes
    /// `#[v8_inherit]` work — derived classes resolve the parent's
    /// template by calling the parent's install, which returns
    /// the cached template on the second call (the first call
    /// typically being the runtime's own register-as-global step).
    pub fn install<'s>(
        scope: &mut v8::PinScope<'s, '_>,
    ) -> v8::Local<'s, v8::FunctionTemplate> {
        if let Some(cached) = scope.get_slot::<__InstallSlot_Marker>() {
            return v8::Local::new(scope, cached.0.clone());
        }
        let __ctor_tmpl = v8::FunctionTemplate::new(
            scope,
            __Marker_constructor_callback,
        );
        let __class_name = v8::String::new(scope, "Marker").unwrap();
        __ctor_tmpl.set_class_name(__class_name);
        __ctor_tmpl.instance_template(scope).set_internal_field_count(1usize);
        let __proto = __ctor_tmpl.prototype_template(scope);
        {
            let __key = v8::String::new(scope, "touch").unwrap();
            let __fn_tmpl = v8::FunctionTemplate::new(scope, __Marker_touch_callback);
            __proto.set(__key.into(), __fn_tmpl.into());
        }
        {
            let __key = v8::String::new(scope, "value").unwrap();
            let __getter_tmpl = v8::FunctionTemplate::new(
                scope,
                __Marker_value_callback,
            );
            let __getter_arg: Option<v8::Local<v8::FunctionTemplate>> = Some(
                __getter_tmpl,
            );
            let __setter_arg: Option<v8::Local<v8::FunctionTemplate>> = None;
            __proto
                .set_accessor_property(
                    __key.into(),
                    __getter_arg,
                    __setter_arg,
                    v8::PropertyAttribute::NONE,
                );
        }
        {
            let __tag_sym = v8::Symbol::get_to_string_tag(scope);
            let __tag_value = v8::String::new(scope, "Marker").unwrap();
            __proto
                .set_with_attr(
                    __tag_sym.into(),
                    __tag_value.into(),
                    v8::PropertyAttribute::READ_ONLY | v8::PropertyAttribute::DONT_ENUM,
                );
        }
        let __global = ::v8::Global::new(scope, __ctor_tmpl);
        let __local = ::v8::Local::new(scope, __global.clone());
        scope.set_slot(__InstallSlot_Marker(__global));
        __local
    }
}
#[allow(non_snake_case, unused_variables, unused_mut, clippy::needless_borrow)]
pub(crate) fn __Marker_constructor_callback(
    scope: &mut v8::PinScope,
    args: v8::FunctionCallbackArguments,
    _rv: v8::ReturnValue,
) {
    if !args.is_construct_call() {
        let __msg = v8::String::new(
                scope,
                "Failed to construct 'Marker': Please use the 'new' operator, this DOM object constructor cannot be called as a function.",
            )
            .unwrap();
        let __exc = v8::Exception::type_error(scope, __msg);
        scope.throw_exception(__exc);
        return;
    }
    let __this = args.this();
    let start: u32 = args.get(0i32).uint32_value(scope).unwrap_or(0);
    let __instance: State = match <State>::new(start) {
        Ok(__v) => __v,
        Err(__err) => {
            if let ::zeroship_runtime::macro_runtime::state::OpErrorKind::JsValue(
                __global,
            ) = &(__err).kind
            {
                let __local = v8::Local::new(scope, __global);
                (scope).throw_exception(__local);
            } else {
                let __msg = v8::String::new(scope, &(__err).message).unwrap();
                let __exc: v8::Local<v8::Value> = match &(__err).kind {
                    ::zeroship_runtime::macro_runtime::state::OpErrorKind::TypeError => {
                        v8::Exception::type_error(scope, __msg)
                    }
                    ::zeroship_runtime::macro_runtime::state::OpErrorKind::RangeError => {
                        v8::Exception::range_error(scope, __msg)
                    }
                    ::zeroship_runtime::macro_runtime::state::OpErrorKind::DomException(
                        __name,
                    ) => {
                        ::zeroship_runtime::macro_runtime::dom::exception::build(
                                scope,
                                &(__err).message,
                                __name,
                            )
                            .into()
                    }
                    ::zeroship_runtime::macro_runtime::state::OpErrorKind::NodeError(
                        __code,
                    ) => {
                        ::zeroship_runtime::macro_runtime::node_error::build_node_exception(
                            scope,
                            __code,
                            &(__err).message,
                        )
                    }
                    ::zeroship_runtime::macro_runtime::state::OpErrorKind::Error => {
                        v8::Exception::error(scope, __msg)
                    }
                    ::zeroship_runtime::macro_runtime::state::OpErrorKind::JsValue(_) => {
                        unreachable!()
                    }
                };
                (scope).throw_exception(__exc);
            }
            return;
        }
    };
    let __boxed = Box::new(__instance);
    let __raw_ptr = Box::into_raw(__boxed);
    let __raw_addr = __raw_ptr as usize;
    let __ext = v8::External::new(scope, __raw_ptr as *mut ::std::ffi::c_void);
    __this.set_internal_field(0, __ext.into());
    let __weak = v8::Weak::with_guaranteed_finalizer(
        scope,
        __this,
        Box::new(move || {
            unsafe {
                drop(Box::from_raw(__raw_addr as *mut State));
            }
        }),
    );
    ::std::mem::forget(__weak);
}
#[allow(non_snake_case, unused_variables, unused_mut, clippy::needless_borrow)]
pub(crate) fn __Marker_touch_callback(
    scope: &mut v8::PinScope,
    args: v8::FunctionCallbackArguments,
    mut rv: v8::ReturnValue,
) {
    let __this = args.this();
    if !__brand_check_Marker(scope, __this) {
        let __msg = v8::String::new(scope, "Illegal invocation").unwrap();
        let __exc = v8::Exception::type_error(scope, __msg);
        scope.throw_exception(__exc);
        return;
    }
    let __ext = match __this
        .get_internal_field(scope, 0)
        .and_then(|v| v8::Local::<v8::External>::try_from(v).ok())
    {
        Some(e) => e,
        None => {
            let __msg = v8::String::new(scope, "Illegal invocation").unwrap();
            let __exc = v8::Exception::type_error(scope, __msg);
            scope.throw_exception(__exc);
            return;
        }
    };
    let __inflight_addr = __ext.value() as usize;
    ::std::thread_local! {
        static __INFLIGHT : ::std::cell::RefCell < ::std::collections::HashSet < usize >>
        = ::std::cell::RefCell::new(::std::collections::HashSet::new());
    }
    let __already_inflight = __INFLIGHT
        .with(|__s| !__s.borrow_mut().insert(__inflight_addr));
    if __already_inflight {
        let __msg = v8::String::new(
                scope,
                "re-entered method `Marker::touch` on instance — concurrent &mut self callback",
            )
            .unwrap();
        let __exc = v8::Exception::type_error(scope, __msg);
        scope.throw_exception(__exc);
        return;
    }
    struct __ReentryGuard(usize);
    impl ::std::ops::Drop for __ReentryGuard {
        fn drop(&mut self) {
            __INFLIGHT
                .with(|__s| {
                    __s.borrow_mut().remove(&self.0);
                });
        }
    }
    let __reentry_guard = __ReentryGuard(__inflight_addr);
    let __instance = unsafe { &mut *(__ext.value() as *mut State) };
    let __r = <State>::touch(&mut *__instance);
    rv.set(v8::Integer::new_from_unsigned(scope, __r).into());
}
