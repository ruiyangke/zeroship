pub(crate) fn __Spreader_constructor_callback(
    scope: &mut v8::PinScope,
    args: v8::FunctionCallbackArguments,
    _rv: v8::ReturnValue,
) {
    if !args.is_construct_call() {
        let __msg = v8::String::new(
                scope,
                "Failed to construct 'Spreader': Please use the 'new' operator, this DOM object constructor cannot be called as a function.",
