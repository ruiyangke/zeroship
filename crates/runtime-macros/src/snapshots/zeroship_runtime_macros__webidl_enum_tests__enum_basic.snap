        match __s {
            "navigate" => ::std::option::Option::Some(Self::Navigate),
            "same-origin" => ::std::option::Option::Some(Self::SameOrigin),
            "no-cors" => ::std::option::Option::Some(Self::NoCors),
            "cors" => ::std::option::Option::Some(Self::Cors),
            _ => ::std::option::Option::None,
        }
    }
    /// Variant → WebIDL name. Round-trips with `from_str`.
    #[allow(dead_code)]
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Navigate => "navigate",
            Self::SameOrigin => "same-origin",
            Self::NoCors => "no-cors",
            Self::Cors => "cors",
        }
    }
}
