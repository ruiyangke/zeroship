            return ::std::option::Option::Some(Self::Sha1);
        }
        if __s.eq_ignore_ascii_case("SHA-256") {
            return ::std::option::Option::Some(Self::Sha256);
        }
        if __s.eq_ignore_ascii_case("SHA-512") {
            return ::std::option::Option::Some(Self::Sha512);
        }
        ::std::option::Option::None
    }
    /// Variant → WebIDL name. Round-trips with `from_str`.
    #[allow(dead_code)]
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Sha1 => "SHA-1",
            Self::Sha256 => "SHA-256",
            Self::Sha512 => "SHA-512",
        }
    }
}
