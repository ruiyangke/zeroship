    /// Brand `obj`, whose internal field 0 holds `state` (a
    /// `Box` of this class's state), as a wrapper of this class
    /// and of every class it inherits from. Only
    /// `__zs_install` and a derived class's `__zs_brand` call
    /// it.
    #[doc(hidden)]
    pub fn __zs_brand(
