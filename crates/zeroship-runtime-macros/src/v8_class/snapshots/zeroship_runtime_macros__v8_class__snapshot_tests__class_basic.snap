            let __setter_arg: Option<v8::Local<v8::FunctionTemplate>> = Some(
                __setter_tmpl,
            );
            __proto
                .set_accessor_property(
                    __key.into(),
                    __getter_arg,
                    __setter_arg,
                    v8::PropertyAttribute::NONE,
                );
        }
        {
            let __tag_sym = v8::Symbol::get_to_string_tag(scope);
            let __tag_value = v8::String::new(scope, "Foo").unwrap();
