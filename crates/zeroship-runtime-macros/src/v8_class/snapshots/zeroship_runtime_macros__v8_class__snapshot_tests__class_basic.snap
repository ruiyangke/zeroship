impl Foo {
    fn new(start: u32) -> Foo {
        Foo { value: start }
    }
    fn touch(&mut self) -> u32 {
        self.value += 1;
        self.value
    }
    fn value(&self) -> u32 {
        self.value
    }
    fn set_value(&mut self, n: u32) {
        self.value = n;
    }
}
/// Per-class isolate-slot marker holding the cached
