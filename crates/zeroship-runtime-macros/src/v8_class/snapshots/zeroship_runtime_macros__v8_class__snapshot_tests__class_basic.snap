        {
            let __key = v8::String::new(scope, "touch").unwrap();
            let __fn_tmpl = ::zeroship_runtime::macro_runtime::callback::template(
                scope,
                __Foo_touch_callback,
            );
            __proto.set(__key.into(), __fn_tmpl.into());
        }
