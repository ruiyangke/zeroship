node_modules/
dist/
.dist/
.direnv/
result
*.db
*.db-shm
*.db-wal
target/
refs/
test-results/
perf.data
perf-compio.data
.worktrees/
.superpowers/
config/verdaccio/storage/

# Local dev state: `zeroship serve` writes the default redb KV file
# (`./.zeroship/kv.redb` + lock) and the storage root (`.zeroship/storage`)
# here. Never tracked.
.zeroship/

# Never commit dotenv files — only the .example templates
.env
.env.*
!.env.example
!.env.*.example

# WPT is fetched on demand by crates/runtime/tests/setup-wpt.sh, not
# tracked. Keeps .git small (the WPT depth=1 pack is ~140 MB).
crates/runtime/tests/wpt/

# Reject foreign package-manager lockfiles — pnpm-lock.yaml is the source of truth.
package-lock.json
yarn.lock

# Go build artefacts for nomad-driver-ch (the driver has its own .gitignore
# but be defensive — `make build` drops binaries here).
nomad-driver-ch/bin/
