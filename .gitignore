node_modules/
dist
.dist/
.direnv/
result
*.db
*.db-shm
*.db-wal
target/
# llvm-cov runs use CARGO_TARGET_DIR=target-cov; `target/` does not match it,
# and the directory reached 990M untracked on 2026-08-29.
target-cov/
refs/
test-results/
blob-cache/
perf.data
perf-compio.data
.worktrees/
/.scratch/
.superpowers/
deploy/verdaccio/storage/

# Generated platform secrets for the local compose stack. Never track them.
deploy/compose/secrets/

# Local dev state: `zeroship serve` writes the default redb KV file
# (`./.zeroship/kv.redb` + lock) and the storage root (`.zeroship/storage`)
# here. Never tracked.
.zeroship/
data/builder-client-secret

# Never commit dotenv files — only the .example templates
.env
.env.*
!.env.example
!.env.*.example

# WPT comes from the development shell's pinned `wpt` flake input, which the
# shell links at crates/zeroship-runtime/tests/wpt, and is not tracked. The tree
# lives in the Nix store, not in .git.
# No trailing slash: with one, this pattern matches only a directory, and the
# shell links a SYMLINK there, which would show up as untracked and get staged
# by a `git add crates/zeroship-runtime/tests`.
crates/zeroship-runtime/tests/wpt

# Reject foreign package-manager lockfiles — pnpm-lock.yaml is the source of truth.
package-lock.json
yarn.lock

# Go build artefacts for nomad-driver-ch (the driver has its own .gitignore
# but be defensive — `make build` drops binaries here).
nomad-driver-ch/bin/

# Claude Code local state
.claude/

# ...except the scaffold's agent skills. These are product content that
# `npm create zeroship-app` copies into a creator's project, not local state.
# The rule above matches `.claude/` at any depth, so without this negation a
# clean checkout ships the `.opencode` half of the skills and not this one.
!packages/create-zeroship-app/template/.claude/

# Pilot notes: local working artifacts, deliberately never committed.
docs/pilot/

# The test backends' overlay, written by tests/provision_test_backends.sh.
#
# Generated rather than committed because it contains live test credentials and
# belongs to the local backend instance that the provisioner owns.
deploy/ops/zeroship.test.toml
__pycache__/

# Excluded dev-only crates resolve on their own when a command names their
# manifest; the workspace lock is the one that pins shipped dependencies.
libs/compio-postgres/testkit/Cargo.lock
